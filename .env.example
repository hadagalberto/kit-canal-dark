# Copie para .env (copy .env.example .env) e preencha. O .env nunca vai para o git.
# Sem nenhuma chave o kit funciona no modo exemplo: gera um MP4 de demonstração.

# Este arquivo vale para a MÁQUINA (todos os canais). O que é de cada canal (marca, assunto, feeds, fontes,
# voz, estilos, redes, turno e se publica) fica na ficha do canal: crie pelo painel, em "+ Novo canal".
# Detalhes em docs/GLOSSARIO.md.

# ---------------------------------------------------------------- segurança
# exemplo = sem chave, notícia e voz de exemplo (nunca publica)
# api     = pauta real, LLM, voz ElevenLabs
MOTOR=exemplo
# Trava geral. 1 = nenhum canal publica (ensaio). 0 = publica só o canal com "publicar": true na ficha.
DRY_RUN=1

# Fuso dos turnos (o "agenda" de cada ficha) e das datas
FUSO_HORAS=-3

# ---------------------------------------------------------------- chaves (só no MOTOR=api)
# Provedor do LLM: anthropic (API direta, apuração com busca web do servidor)
#                  openrouter (uma chave só para LLM e imagens; qualquer modelo de openrouter.ai/models)
LLM_PROVEDOR=anthropic
ANTHROPIC_API_KEY=
# Vazio = padrão do provedor:
#   anthropic:  claude-sonnet-5-5 / claude-haiku-5-5
#   openrouter: anthropic/claude-sonnet-5.5 / anthropic/claude-haiku-5.5
LLM_MODELO_FORTE=
LLM_MODELO_BARATO=
# Teto de gasto de LLM por dia somando TODOS os canais (US$). Vazio = só o teto de cada canal
# (llm_usd_dia no pipeline.json do canal, padrão 5).
LLM_USD_DIA_TOTAL=

# Voz: uma conta ElevenLabs para todos os canais (os créditos do plano são divididos entre eles).
# A chave precisa da permissão Text to Speech; com User -> Read, a Caixa do painel mostra o saldo.
ELEVENLABS_API_KEY=
# Voz padrão (id na Voice Library da ElevenLabs), para o canal cuja ficha não tem "voice_id" próprio.
ELEVENLABS_VOICE_ID=
# Modelo da ElevenLabs. eleven_v4 entende as tags de emoção ([excited], [measured]...) do roteiro.
ELEVENLABS_MODELO=eleven_v4

# OpenRouter: LLM (com LLM_PROVEDOR=openrouter) e imagem de IA da mídia
OPENROUTER_API_KEY=

# Mídia opcional (ligue "media_enabled": true no pipeline.json do canal)
LOGODEV_TOKEN=
IMAGEM_IA_MODELO=google/gemini-3.1-flash-lite-image

# ---------------------------------------------------------------- redes (README, "Conectar as contas")
# Os logins são por canal e ficam em /dados/segredos/<canal>/; nenhuma senha de rede vai neste arquivo.
# public | unlisted | private  (unlisted é bom para os primeiros testes)
YOUTUBE_PRIVACIDADE=public
# Instagram é API NÃO oficial: risco de bloqueio da conta. Precisa de INSTALAR_INSTAGRAM=1 e rebuild.
INSTALAR_INSTAGRAM=0
# 1 = apaga o MP4 da pasta saida depois de publicar em pelo menos uma rede
APAGAR_MP4_PUBLICADO=0

# ---------------------------------------------------------------- avisos no Telegram (opcional)
# Um bot para a máquina. O chat pode ser um só (aqui) ou um por canal ("telegram_chat_id" na ficha).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 = avisa também cada ensaio pronto (útil no começo; depois vira barulho)
TELEGRAM_AVISAR_ENSAIO=0

# ---------------------------------------------------------------- painel: caixa
# Dólar fixo para converter os gastos (vazio = PTAX do Banco Central, uma consulta a cada 6 h)
USD_BRL=

# ---------------------------------------------------------------- máquina
PAINEL_PORTA=8787
LIMITE_MEMORIA=6g
LIMITE_CPUS=4
RENDER_CONCURRENCY=4
